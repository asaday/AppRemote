<Window x:Class="AppRemote.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="App Remote" Icon="Assets/app.ico" Height="610" Width="760" MinHeight="520" MinWidth="630"
        Background="#10151D" Foreground="#F2F5F8" FontFamily="Segoe UI"
        Loaded="Window_Loaded" Closed="Window_Closed">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="#27364A" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>
    <Grid Margin="26">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="245" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="App Remote" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,6" />
        <TextBlock x:Name="VersionText" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                   Foreground="#A9B8C7" FontSize="13" Margin="0,0,0,6" />
        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="Choose a window on this PC. Only that window will appear on your phone."
                   Foreground="#A9B8C7" TextWrapping="Wrap" Margin="0,0,0,22" />
        <Grid Grid.Row="2" Margin="0,0,22,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,10">
                <TextBlock Text="Windows" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Content="Refresh" DockPanel.Dock="Right" HorizontalAlignment="Right" Click="Refresh_Click" />
            </DockPanel>
            <ListBox x:Name="WindowList" Grid.Row="1" Background="#1A2330" Foreground="White" BorderBrush="#34465C"
                     BorderThickness="1" FontSize="14" Padding="6" MouseDoubleClick="WindowList_DoubleClick" />
            <StackPanel Grid.Row="2" Margin="0,12,0,0">
                <Button Content="Control this window" Background="#1768B3" HorizontalAlignment="Left" Click="Select_Click" />
                <TextBlock x:Name="SelectedText" Text="No window selected" Foreground="#A9B8C7" Margin="0,12,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
        <Border Grid.Row="2" Grid.Column="1" Background="#1A2330" CornerRadius="12" Padding="16">
            <StackPanel>
                <TextBlock Text="Connect your phone" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Text="Scan the QR code on the same Wi-Fi network." Foreground="#A9B8C7" TextWrapping="Wrap" Margin="0,8,0,14" />
                <Border Background="White" Width="205" Height="205" HorizontalAlignment="Center" Padding="8">
                    <Image x:Name="QrImage" Stretch="Uniform" />
                </Border>
                <TextBlock x:Name="UrlText" Text="Starting server..." TextWrapping="Wrap" FontSize="11" Foreground="#B4D5FF" Margin="0,12,0,0" />
                <Button x:Name="CopyUrlButton" Content="Copy URL" IsEnabled="False" HorizontalAlignment="Left" Margin="0,8,0,0" Click="CopyUrl_Click" />
                <TextBlock Text="Open the QR code in your phone's browser." Foreground="#A9B8C7" TextWrapping="Wrap" Margin="0,14,0,0" />
            </StackPanel>
        </Border>
        <TextBlock x:Name="StatusText" Grid.Row="3" Grid.ColumnSpan="2" Text="Starting..." Foreground="#89D7A3" Margin="0,20,0,0" />
    </Grid>
</Window>
